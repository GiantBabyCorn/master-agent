# ============================================================================
# Master Agent Environment Variables
# Copy this file to `.env` and edit values for your environment.
# Example:
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# [APP] Runtime and API basics
# ----------------------------------------------------------------------------
# NODE_ENV
# Purpose: Runtime mode used by app behavior and logging.
# Allowed: development | test | production
# Example: NODE_ENV=development
NODE_ENV=development

# PORT
# Purpose: API listen port.
# Format: integer (1-65535)
# Example: PORT=3000
PORT=3000

# ----------------------------------------------------------------------------
# [DATABASE CREDENTIALS] Shared by Docker Compose Postgres
# ----------------------------------------------------------------------------
# POSTGRES_USER
# Purpose: Database login username used by Postgres container.
# Security note: use non-default value outside local dev.
# Example: POSTGRES_USER=master_agent_user
POSTGRES_USER=postgres

# POSTGRES_PASSWORD
# Purpose: Database login password used by Postgres container.
# Security note: DO NOT keep weak/default password in real environments.
# Generate strong password examples:
#   openssl rand -base64 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change_me

# POSTGRES_DB
# Purpose: Database name created by Postgres container on first boot.
# Example: POSTGRES_DB=master_agent
POSTGRES_DB=master_agent

# DATABASE_URL
# Purpose: SQLAlchemy connection string for PostgreSQL.
# How to get:
#   - Docker compose local: use postgres service credentials
#   - Managed DB: copy connection URL from provider dashboard
# Format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Example:
#   DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/master_agent"
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/master_agent"

# COMPOSE_DATABASE_URL
# Purpose: Database URL used by API container in Docker Compose mode.
# Why separate from DATABASE_URL:
#   - host runtime often uses localhost
#   - container runtime must use compose DB service host
# Format:
#   postgresql+psycopg://<user>:<password>@master_agent_db:5432/<database>
# Example:
#   COMPOSE_DATABASE_URL="postgresql+psycopg://master_agent_user:strong_password@master_agent_db:5432/master_agent"
COMPOSE_DATABASE_URL="postgresql+psycopg://postgres:change_me@master_agent_db:5432/master_agent"

# LOG_LEVEL
# Purpose: Application log verbosity.
# Allowed: trace | debug | info | warn | error | fatal
# Example: LOG_LEVEL=info
LOG_LEVEL=info

# API_PREFIX
# Purpose: Unversioned API prefix (legacy/compat routes).
# Example: API_PREFIX=/api
API_PREFIX=/api

# API_V1_PREFIX
# Purpose: Versioned API prefix used by dashboard-ready contract.
# Example: API_V1_PREFIX=/api/v1
API_V1_PREFIX=/api/v1


# ----------------------------------------------------------------------------
# [TELEGRAM] Bot transport and security
# ----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN
# Purpose: Bot credential for Telegram Bot API calls.
# How to get:
#   1) Open Telegram -> @BotFather
#   2) Run /newbot and finish setup
#   3) Copy token returned by BotFather
# Format:
#   <digits>:<alpha_numeric_token>
# Example:
#   TELEGRAM_BOT_TOKEN="123456789:AAExampleTokenValue"
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET
# Purpose: Shared secret to validate webhook requests
#          (header: x-telegram-bot-api-secret-token).
# How to get: generate your own random secret.
# Suggestion:
#   openssl rand -hex 32
# Format: long random string (32+ chars recommended)
# Example:
#   TELEGRAM_WEBHOOK_SECRET="f4e2a9...<64-hex>..."
TELEGRAM_WEBHOOK_SECRET=""

# TELEGRAM_WEBHOOK_URL
# Purpose: Public HTTPS base URL where Telegram can reach your API.
# How to get:
#   - Production domain (recommended), or
#   - Tunneling URL (e.g. ngrok/cloudflared) for local testing
# Format:
#   https://<public-domain>
# Example:
#   TELEGRAM_WEBHOOK_URL="https://master-agent.example.com"
TELEGRAM_WEBHOOK_URL=""

# TELEGRAM_ALLOWED_USER_IDS
# Purpose: Optional allowlist for Telegram user IDs.
# How to get:
#   - Send a message to your bot
#   - Inspect inbound payload `message.from.id` in logs/db
# Format:
#   comma-separated numeric IDs, no spaces
# Example:
#   TELEGRAM_ALLOWED_USER_IDS="12345678,87654321"
# Leave empty to allow all users.
TELEGRAM_ALLOWED_USER_IDS=""

# TELEGRAM_MODE
# Purpose: Select transport mode.
# Allowed:
#   webhook  -> receive updates via HTTP callback (recommended for prod)
#   polling  -> bot fetches updates periodically
#   disabled -> Telegram integration off
# Example: TELEGRAM_MODE=webhook
TELEGRAM_MODE=webhook

# TELEGRAM_POLL_INTERVAL_SEC
# Purpose: Sleep interval between polling loops.
# Used when TELEGRAM_MODE=polling.
# Format: integer seconds
# Example: TELEGRAM_POLL_INTERVAL_SEC=3
TELEGRAM_POLL_INTERVAL_SEC=3

# TELEGRAM_POLLING_TIMEOUT_SEC
# Purpose: Long-poll timeout sent to Telegram getUpdates.
# Used when TELEGRAM_MODE=polling.
# Format: integer seconds
# Example: TELEGRAM_POLLING_TIMEOUT_SEC=30
TELEGRAM_POLLING_TIMEOUT_SEC=30


# ----------------------------------------------------------------------------
# [CURSOR] Cursor CLI and Cloud Agents API
# ----------------------------------------------------------------------------
# CURSOR_CLI_COMMAND
# Purpose: Executable used for local Cursor CLI tasks.
# How to get:
#   - Install Cursor CLI from official docs
#   - Ensure command is available in PATH
# Common values: agent | cursor | full executable path
# Example:
#   CURSOR_CLI_COMMAND="agent"
CURSOR_CLI_COMMAND="agent"

# CURSOR_CLI_TIMEOUT_MS
# Purpose: Max runtime for CLI invocation before timeout.
# Format: integer milliseconds
# Example: CURSOR_CLI_TIMEOUT_MS=120000
CURSOR_CLI_TIMEOUT_MS=120000

# CURSOR_CLOUD_API_KEY
# Purpose: API key for Cursor Cloud Agents API.
# How to get:
#   Cursor Dashboard -> Integrations -> create API key
# Format: key_xxxxxxxxxx...
# Example:
#   CURSOR_CLOUD_API_KEY="key_XXXXXXXXXXXXXXXXXXXXXXXX"
CURSOR_CLOUD_API_KEY=""

# CURSOR_CLOUD_BASE_URL
# Purpose: Base URL for Cursor Cloud API.
# Default should remain unchanged unless Cursor changes endpoint.
# Example: CURSOR_CLOUD_BASE_URL="https://api.cursor.com"
CURSOR_CLOUD_BASE_URL="https://api.cursor.com"


# ----------------------------------------------------------------------------
# [ANTHROPIC] Claude integration
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY
# Purpose: API key for Claude Agent SDK / Anthropic API.
# How to get:
#   Anthropic Console -> API Keys -> create key
# Format: sk-ant-...
# Example:
#   ANTHROPIC_API_KEY="sk-ant-api03-..."
ANTHROPIC_API_KEY=""

# ANTHROPIC_CLI_COMMAND
# Purpose: CLI executable for Claude local automation.
# How to get:
#   Install Claude CLI and ensure command exists in PATH.
# Example: ANTHROPIC_CLI_COMMAND="claude"
ANTHROPIC_CLI_COMMAND="claude"


# ----------------------------------------------------------------------------
# [CODEX] OpenAI Codex integration
# ----------------------------------------------------------------------------
# CODEX_CLI_COMMAND
# Purpose: CLI executable for Codex automation.
# How to get:
#   Install Codex CLI and ensure command exists in PATH.
# Example: CODEX_CLI_COMMAND="codex"
CODEX_CLI_COMMAND="codex"

# CODEX_ENABLE_API
# Purpose: Feature flag for future Codex API path.
# Allowed: true | false
# Example: CODEX_ENABLE_API=false
CODEX_ENABLE_API=false

# CODEX_API_KEY
# Purpose: Reserved for API mode when enabled.
# How to get:
#   OpenAI platform key (or future Codex-specific key flow).
# Format: sk-...
# Example:
#   CODEX_API_KEY="sk-proj-..."
CODEX_API_KEY=""


# ----------------------------------------------------------------------------
# [DOCKER BUILD] Optional CLI auto-install inside container
# ----------------------------------------------------------------------------
# DOCKER_INSTALL_NODEJS
# Purpose: Install nodejs/npm in API image (needed by many CLI installers).
# Allowed: true | false
# Example: DOCKER_INSTALL_NODEJS=true
DOCKER_INSTALL_NODEJS=true

# DOCKER_CURSOR_CLI_INSTALL_CMD
# Purpose: Optional shell command executed at Docker build time to install Cursor CLI.
# Example:
#   DOCKER_CURSOR_CLI_INSTALL_CMD="curl https://cursor.com/install -fsS | bash"
# Official docs:
#   https://cursor.com/docs/cli/overview
# Update check:
#   - Read Cursor changelog: https://cursor.com/changelog
#   - Manual version check in container: docker compose exec master_agent_api bash -lc "agent --version"
DOCKER_CURSOR_CLI_INSTALL_CMD="curl https://cursor.com/install -fsS | bash"

# DOCKER_ANTHROPIC_CLI_INSTALL_CMD
# Purpose: Optional shell command executed at Docker build time to install Claude CLI.
# Official docs:
#   https://docs.anthropic.com/en/docs/claude-code/setup
# Stable channel install:
#   curl -fsSL https://claude.ai/install.sh | bash -s stable
# Update check:
#   - Manual update: claude update
#   - Health/version check in container: docker compose exec master_agent_api bash -lc "claude doctor && claude --version"
DOCKER_ANTHROPIC_CLI_INSTALL_CMD="curl -fsSL https://claude.ai/install.sh | bash -s stable"

# DOCKER_CODEX_CLI_INSTALL_CMD
# Purpose: Optional shell command executed at Docker build time to install Codex CLI.
# Official docs:
#   https://developers.openai.com/codex/cli/
#   https://github.com/openai/codex
# Update check:
#   - npm registry latest: npm view @openai/codex version
#   - installed version in container: docker compose exec master_agent_api bash -lc "codex --version"
DOCKER_CODEX_CLI_INSTALL_CMD="npm install -g @openai/codex"


# ----------------------------------------------------------------------------
# [POLICY] Master Agent approval behavior
# ----------------------------------------------------------------------------
# APPROVAL_POLICY_DEFAULT
# Purpose: Default safety posture used by policy engine.
# Allowed: strict | balanced | aggressive
# Recommended: balanced
# Example: APPROVAL_POLICY_DEFAULT=balanced
APPROVAL_POLICY_DEFAULT=balanced

# ORCHESTRATION_MODE
# Purpose: Select orchestration strategy.
# Allowed:
#   rules   -> deterministic orchestrator + policy engine
#   agentic -> master-agent style orchestrator (MVP routes through common pipeline)
# Example: ORCHESTRATION_MODE=rules
ORCHESTRATION_MODE=rules

# APPROVAL_AUTO_APPROVE_READ_ONLY
# Purpose: Auto-approve read-only requests when possible.
# Allowed: true | false
# Example: APPROVAL_AUTO_APPROVE_READ_ONLY=true
APPROVAL_AUTO_APPROVE_READ_ONLY=true

# APPROVAL_MEDIUM_REQUIRES_USER
# Purpose: Whether medium-risk tasks require manual approval.
# Allowed: true | false
# Example: APPROVAL_MEDIUM_REQUIRES_USER=true
APPROVAL_MEDIUM_REQUIRES_USER=true


# ----------------------------------------------------------------------------
# [RESILIENCE] Timeouts, retry, and circuit breaker
# ----------------------------------------------------------------------------
# REQUEST_TIMEOUT_SEC
# Purpose: Default outbound HTTP timeout.
# Format: integer seconds
# Example: REQUEST_TIMEOUT_SEC=30
REQUEST_TIMEOUT_SEC=30

# RETRY_MAX_ATTEMPTS
# Purpose: Maximum retry attempts for retry-enabled operations.
# Format: integer >= 1
# Example: RETRY_MAX_ATTEMPTS=3
RETRY_MAX_ATTEMPTS=3

# RETRY_BASE_DELAY_MS
# Purpose: Base delay used in exponential backoff.
# Format: integer milliseconds
# Example: RETRY_BASE_DELAY_MS=300
RETRY_BASE_DELAY_MS=300

# CIRCUIT_BREAKER_FAIL_THRESHOLD
# Purpose: Failures needed before opening circuit.
# Format: integer >= 1
# Example: CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CIRCUIT_BREAKER_FAIL_THRESHOLD=5

# CIRCUIT_BREAKER_RECOVERY_SEC
# Purpose: Cooldown period before trying again after circuit opens.
# Format: integer seconds
# Example: CIRCUIT_BREAKER_RECOVERY_SEC=30
CIRCUIT_BREAKER_RECOVERY_SEC=30


# ----------------------------------------------------------------------------
# [DATABASE BOOTSTRAP] Startup behavior
# ----------------------------------------------------------------------------
# DB_AUTO_CREATE_TABLES
# Purpose: Auto-create tables on startup (bootstrap only).
# Allowed: true | false
# Recommendation:
#   - true for early local development
#   - false after you move to Alembic migrations in production
DB_AUTO_CREATE_TABLES=true

# DB_ENABLE_STARTUP_MIGRATION_GATE
# Purpose: Guard startup with baseline table checks.
# Allowed: true | false
# Example: DB_ENABLE_STARTUP_MIGRATION_GATE=true
DB_ENABLE_STARTUP_MIGRATION_GATE=true
